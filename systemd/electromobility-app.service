[Unit]
Description=VoltoShare tenant application (explicit fictional demo)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/mathis/openclaw-workspace/Economics-of-electromobility/tenant-app
EnvironmentFile=/home/mathis/.config/voltoshare/app.env
ExecStart=/home/mathis/.local/share/voltoshare-venv/bin/gunicorn --bind 127.0.0.1:18820 --workers 2 --timeout 45 --max-requests 1000 --max-requests-jitter 100 config.wsgi:application
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
