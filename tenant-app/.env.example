# Create a private env file OUTSIDE the repository; never commit real values.
VOLTO_SECRET_KEY=replace-with-a-private-random-secret
VOLTO_DB=/absolute/private/path/voltoshare.sqlite3
VOLTO_STATIC=/absolute/path/to/tenant-app/staticfiles
VOLTO_HOSTS=app.example.invalid
VOLTO_CSRF_ORIGINS=https://app.example.invalid
VOLTO_APP_URL=https://app.example.invalid
VOLTO_SECURE=1
# Safe default: no public demo persona sign-in and no demo seed/reset command.
VOLTO_DEMO=0
